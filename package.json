{
  "name": "pauseai-uk",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "vitest run --project node && npm run lint && npm run lint:css && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "prek install",
    "test": "vitest run --coverage",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:storyboard": "playwright test",
    "storyboard": "node scripts/storyboard.mjs",
    "test:report": "playwright show-report",
    "data:ai-sentiment": "node scripts/generate-ai-sentiment-data.mjs",
    "data:story-image-detect-faces": "node scripts/detect-face-positions.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:schema": "node scripts/db-schema.mjs"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "d3-geo": "^3.1.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@j178/prek": "0.5.7",
    "@jsx-email/doiuse-email": "1.0.4",
    "@playwright/test": "^1.64.1",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "knip": "6.42.1",
    "msw": "^3.0.3",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
