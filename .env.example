# Copy to .env.local (git ignores it) and edit it:
#   cp .env.example .env.local
# `npm run dev` and `npm run db:reset` read .env.local. On Netlify, set the
# same variables in the site's settings, except the local-only ones.
#
# Without a setting, that part refuses to work rather than guessing: no
# Postmark token, no letters; and so on. Turnstile is the exception: without
# its keys, it's skipped. Netlify sets URL and CONTEXT itself, and only a
# CONTEXT of "production" can send letters to real MPs.

# --- Database -------------------------------------------------------------

# Postgres. `npm run db:reset` makes this database from scratch, so name one
# on your own machine. Netlify sets this itself for the live site.
# The default matches docker-compose.yml (`docker compose up -d`). With a
# Postgres installed natively instead:
#   Mac (Postgres.app):  postgresql://localhost/pauseai_dev
#   Linux (apt):         postgresql:///pauseai_dev?host=/var/run/postgresql
NETLIFY_DB_URL=postgresql://postgres:postgres@localhost:5432/pauseai_dev

# Optional. The server where tests make their throwaway databases. `db-test`
# in docker-compose.yml is an in-memory Postgres for this: never point
# NETLIFY_DB_URL at it. Unset, tests use the PG* variables or the local socket.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Where the test MPs' letters go (lib/test-mps.json), except ZZ99ZN's, who has
# no email, and ZZ99ZH's, which bounce.
# db:reset adds the test MPs with this inbox; on Netlify, the nightly MP sync does.
# On the live site, test@pauseai.uk.
TEST_MP_EMAIL=you@example.com

# Read-only Airtable token for the "UK Parliamentarians" table: the nightly MP
# sync copies the MPs from it, and /staff/import the signatories. With
# DATA_FIXTURES=1, any value.
AIRTABLE_TOKEN=

# --- Local development only ------------------------------------------------

# Google Analytics and Tag Manager load only on the live site (Netlify's
# production context). Set to 1 to load them anywhere else, as the storyboard's
# fixture build does to test cookie consent; it blocks the requests itself.
# ANALYTICS=1

# 1 fakes every outside service (Luma, postcodes.io, Airtable, Parliament,
# Turnstile, Postmark) from tests/fixtures/, so nothing below is needed.
# Delete it to use the real services.
DATA_FIXTURES=1

# Emails that aren't sent are written here instead: with DATA_FIXTURES=1,
# or in the dev server without a real POSTMARK_SERVER_TOKEN.
OUTBOX_DIR=tmp/outbox

# --- Site -------------------------------------------------------------------

# Luma's official API, for our calendar's events (homepage, /events, local
# groups, collateral), registrations on the flyering trackers, and adding
# people who register at /march to the march's event. Without it no events
# are listed, and registering at /march fails.
LUMA_API_KEY=

# The secret of the webhook Luma posts to /api/luma/webhook when someone
# unsubscribes from the calendar's emails, or subscribes (docs/development.md,
# "Deploying"). It starts whsec_. Without it, every webhook is refused.
LUMA_WEBHOOK_SECRET=

# Stripe, a restricted key that can only read Checkout Sessions and Payment
# Intents, for the names and dates on the donate page of donors who said yes to the wall of thanks.
# Without it, the donate page shows no names.
STRIPE_WALL_OF_THANKS_KEY=

# The Luma event /march adds people to: its API ID, evt-…, from the address
# of the event's manage page. A test event while checking the sign-up, then
# the march's. Without it, registering at /march fails. See
# docs/development.md, "The march sign-up and Luma".
LUMA_MARCH_EVENT_ID=

# --- Email your MP ----------------------------------------------------------

# Cloudflare Turnstile, the anti-spam check. With neither key set, it's
# skipped, everywhere, leaving only the honeypot. Set both, or neither.
# Cloudflare's always-pass test keys: 1x00000000000000000000AA and
# 1x0000000000000000000000000000000AA (refused by a production build).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Postmark server token. Not needed with DATA_FIXTURES=1. In the dev server,
# without one or with Postmark's test token POSTMARK_API_TEST, emails go to
# OUTBOX_DIR instead.
POSTMARK_SERVER_TOKEN=

# Basic auth on Postmark's bounce and inbound webhooks.
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# The PauseAI inbox that gets a blind copy of every letter and a copy of
# every MP's reply, and is in each letter's Reply-To: on the live site,
# policy@pauseai.uk.
REPLIES_INBOX=

# Optional. These are the defaults.
# LETTERS_MAIL_DOMAIN=letters.pauseai.uk
# NOTIFY_MAIL_DOMAIN=notify.pauseai.uk

# Staff (/staff) log in with a link emailed through Postmark to their
# pauseai.uk address, so they need nothing more. Locally, with
# DATA_FIXTURES=1, the link is in the newest file in tmp/outbox/.

# --- Daily jobs --------------------------------------------------------------

# Any long random string. The daily jobs send it to /api/cron/*; locally,
# send it yourself with curl.
CRON_SECRET=
